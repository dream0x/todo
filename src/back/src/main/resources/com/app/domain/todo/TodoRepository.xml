<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.app.domain.todo.TodoRepository">

  <resultMap id="todoResultMap" type="com.app.domain.todo.Todo">
    <id property="id" column="id"/>
    <result property="title" column="title"/>
    <result property="completed" column="completed"/>
    <result property="version" column="version"/>
    <result property="createdAt" column="created_at"/>
    <result property="updatedAt" column="updated_at"/>
  </resultMap>

  <select id="findAll" resultMap="todoResultMap">
    SELECT id, title, completed, version, created_at, updated_at
    FROM todos
    ORDER BY created_at, id
  </select>

  <select id="findById" resultMap="todoResultMap">
    SELECT id, title, completed, version, created_at, updated_at
    FROM todos
    WHERE id = #{id}
  </select>
</mapper>
